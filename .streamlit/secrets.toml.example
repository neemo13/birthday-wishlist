# Copy this file to `.streamlit/secrets.toml` for local development.
# On Streamlit Community Cloud, paste the same keys into App settings -> Secrets.
# NEVER commit the real secrets.toml (it is in .gitignore).

# Supabase project URL (Project Settings -> API -> Project URL)
SUPABASE_URL = "https://YOUR-PROJECT-REF.supabase.co"

# The *service_role* key (Project Settings -> API Keys). It bypasses Row Level Security,
# so it must only ever live here, on the server. Never put it in a browser, repo or chat.
SUPABASE_SERVICE_KEY = "YOUR-SERVICE-ROLE-KEY"

# "dev" for your own computer, "prod" for the deployed app. prod refuses to start with a non-https URL or placeholders.
APP_ENV = "dev"

# Optional: DEBUG, INFO (default), WARNING, ERROR. Secrets are never logged at any level.
# LOG_LEVEL = "INFO"

# Private Storage bucket created by sql/999_storage_and_lockdown.sql
SUPABASE_BUCKET = "wishlist-images"

# The admin password, family PIN and Dad Only PIN are NOT stored here.
# They are set with `python scripts/set_credential.py` (hashed inside the database).
